{
  "description": "Experiment configurations for UBQP hybrid r-flip research",
  
  "experiments": {
    "quick_test": {
      "description": "Quick validation test (small instances, fast)",
      "algorithms": [
        {"name": "eval", "timeout": 60},
        {"name": "ls_all", "timeout": 60},
        {"name": "ls_count_all", "timeout": 60},
        {"name": "vns_figures", "timeout": 60},
        {"name": "vns_figures_count", "timeout": 60},
        {"name": "vns_tables_all", "timeout": 60}
      ],
      "instance_set": "quick_test",
      "generate_figures": true,
      "generate_tables": true
    },
    
    "eval_benchmark": {
      "description": "Evaluation time comparison between strategies",
      "algorithms": ["eval"],
      "instance_set": "eval",
      "timeout": 3600,
      "generate_figures": true,
      "generate_tables": false
    },
    
    "ls_figures": {
      "description": "Local search experiments for figure generation",
      "algorithms": ["ls_all"],
      "instance_set": "ls_figures",
      "timeout": 3600,
      "generate_figures": true,
      "generate_tables": false
    },
    
    "ls_count_figures": {
      "description": "Local search counting for figure generation",
      "algorithms": ["ls_count_all"],
      "instance_set": "ls_figures",
      "timeout": 3600,
      "generate_figures": true,
      "generate_tables": false
    },
    
    "vns_figures": {
      "description": "VNS experiments for figure generation",
      "algorithms": ["vns_figures"],
      "instance_set": "vns_figures",
      "timeout": 7200,
      "generate_figures": true,
      "generate_tables": false
    },
    
    "vns_count_figures": {
      "description": "VNS counting experiments for figure generation",
      "algorithms": ["vns_figures_count"],
      "instance_set": "vns_figures",
      "timeout": 7200,
      "generate_figures": true,
      "generate_tables": false
    },
    
    "vns_tables_small": {
      "description": "VNS benchmark - small instances only (n=50)",
      "algorithms": ["vns_tables_all"],
      "instance_set": "vns_tables_small",
      "timeout": 3600,
      "generate_figures": false,
      "generate_tables": true
    },
    
    "vns_tables_medium": {
      "description": "VNS benchmark - medium instances (n=100, 250)",
      "algorithms": ["vns_tables_all"],
      "instance_set": "vns_tables_medium",
      "timeout": 14400,
      "generate_figures": false,
      "generate_tables": true
    },
    
    "vns_tables_large": {
      "description": "VNS benchmark - large instances (n=500, 1000, 2500)",
      "algorithms": ["vns_tables_all"],
      "instance_set": "vns_tables_large",
      "timeout": 86400,
      "generate_figures": false,
      "generate_tables": true
    },
    
    "vns_tables_full": {
      "description": "Complete VNS benchmark - ALL instances",
      "algorithms": ["vns_tables_all"],
      "instance_set": "vns_tables_all",
      "timeout": 0,
      "generate_figures": false,
      "generate_tables": true
    },
    
    "gset_benchmark": {
      "description": "VNS benchmark on Gset instances",
      "algorithms": ["vns_tables_all"],
      "instance_set": "gset_small",
      "timeout": 14400,
      "generate_figures": false,
      "generate_tables": true
    },
    
    "full_pipeline": {
      "description": "Complete experiment pipeline (all experiments)",
      "steps": [
        "eval_benchmark",
        "ls_figures",
        "ls_count_figures",
        "vns_figures",
        "vns_count_figures",
        "vns_tables_full"
      ],
      "timeout": 0,
      "generate_figures": true,
      "generate_tables": true
    }
  },
  
  "runtime": {
    "max_threads": 4,
    "default_timeout": 3600,
    "output_dir": "output/results",
    "figures_dir": "output/figures",
    "tables_dir": "output/tables"
  },
  
  "algorithms": {
    "eval": "Evaluation time comparison",
    "ls": "Local search (first_improvement)",
    "ls_count": "Local search counting (first_improvement)",
    "ls_all": "Local search (ALL strategies)",
    "ls_count_all": "Local search counting (ALL strategies)",
    "vns_figures": "VNS time experiments",
    "vns_figures_count": "VNS counting experiments",
    "vns_tables": "VNS benchmark (first_improvement)",
    "vns_tables_all": "VNS benchmark (ALL LS strategies)"
  }
}
